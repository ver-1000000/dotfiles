{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],

    "modules-right": [
        "tray",
        "custom/systemstats",
        "battery",
        "clock",
        "group/system"
    ],

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "custom/notification"
        ]
    },

    "hyprland/workspaces": {
        "cursor": true,
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{id}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "hyprland/window": {
        "separate-outputs": true,
        "max-length": 72,
        "rewrite": {
            "^(.*) - Ghostty$": "$1",
            "^(.*) — Mozilla Firefox$": "$1",
            "^(.*) - Google Chrome$": "$1"
        }
    },

    "wlr/taskbar": {
        "cursor": true,
        "format": "{icon} {title}",
        "icon-size": 16,
        "spacing": 6,
        "tooltip-format": "{title}",
        "rewrite": {
            "(.{48}).+$": "$1..."
        },
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "custom/notification": {
        "cursor": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "🔔︎",
            "none": "🔔︎",
            "dnd-notification": "🔕︎",
            "dnd-none": "🔕︎",
            "inhibited-notification": "🔔︎",
            "inhibited-none": "🔔︎",
            "dnd-inhibited-notification": "🔕︎",
            "dnd-inhibited-none": "🔕︎"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "tooltip": false
    },

    "pulseaudio": {
        "cursor": true,
        "format": "🔊 {volume}%",
        "format-muted": "🔇 mute",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/systemstats": {
        "format": "{}",
        "interval": 5,
        "tooltip": false,
        "exec": "bash -lc 'cpu=$(top -bn1 | awk \"/Cpu\\(s\\)/ {print int(100-\\$8); exit}\"); mem=$(free | awk \"/Mem:/ {print int(\\$3*100/\\$2); exit}\"); tmp=$(sensors 2>/dev/null | awk \"/Package id 0:/ {gsub(/[+°C]/, \\\"\\\", \\$4); print int(\\$4); exit}\"); [ -z \"$cpu\" ] && cpu=\"?\"; [ -z \"$mem\" ] && mem=\"?\"; [ -z \"$tmp\" ] && tmp=\"?\"; printf \"CPU %s%%  RAM %s%%  🌡 %sC\" \"$cpu\" \"$mem\" \"$tmp\"'"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-full": "🔋 {capacity}%"
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": false
    },

    "tray": {
        "spacing": 2,
        "cursor": true
    }
}
