#!/usr/bin/env bash

set -euo pipefail

device_name="wacom-bamboofun-6x8-pen"
left_output="HDMI-A-1"
right_output="HDMI-A-2"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state_file="$state_dir/toggle-tablet-monitors.state"

mkdir -p "$state_dir"

current_mode="span"
if [[ -f "$state_file" ]]; then
  current_mode="$(<"$state_file")"
fi

case "$current_mode" in
  span) next_mode="left" ;;
  left) next_mode="right" ;;
  right) next_mode="span" ;;
  *) next_mode="span" ;;
esac

case "$next_mode" in
  left)
    output="$left_output"
    ;;
  right)
    output="$right_output"
    ;;
  span)
    output=""
    ;;
esac

# Lua設定ではkeywordは使えない。hyprctlはエラー本文を返しても終了コードが0の場合がある
if ! result="$(hyprctl eval "hl.device({ name = \"$device_name\", output = \"$output\" })" 2>&1)" ||
  [[ "$result" != "ok" ]]; then
  printf 'Tablet mapping failed: %s\n' "$result" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "toggle-tablet-monitors" "マッピング変更に失敗しました: $result" || true
  fi
  exit 1
fi

printf '%s\n' "$next_mode" > "$state_file"

if command -v notify-send >/dev/null 2>&1; then
  case "$next_mode" in
    left) message="tablet -> $left_output" ;;
    right) message="tablet -> $right_output" ;;
    span) message="tablet -> span" ;;
  esac
  notify-send "toggle-tablet-monitors" "$message" >/dev/null 2>&1 || true
fi
